# Copy to .env and fill in. Without any key the app runs in MOCK mode (placeholder scores).

# Organizers' GET link (any group_id in it is replaced automatically)
DATA_API_URL=

# Free option 1: Google Gemini — key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Several keys, comma-separated (key numbers 1,2,3… in logs). When a key hits its daily limit the next key is used with the
# same model; only when all keys are used up, the next model. GEMINI_API_KEY (above) is added last if it is not in the list.
GEMINI_API_KEYS=
# 0 = use all keys; N = only the first N (keep the rest in reserve)
GEMINI_MAX_KEYS=0
# Names of the keys in the same order (for logs), and optional restriction to some of them (keep the rest in reserve)
GEMINI_KEY_LABELS=
GEMINI_USE_KEYS=
# One model or a comma-separated list (next one is used when a model hits its daily free limit, 20 requests/model/day)
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# minimal / low / medium / high — lower = faster
GEMINI_THINKING=low

# Fallback (last in the chain, used only when every Gemini key and model is at its limit): any OpenAI-compatible API, default Groq — key at https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# auto = every provider that has a key, in order gemini -> openai; or e.g. PROVIDER=openai, PROVIDER=mock
PROVIDER=auto

# Only for the cost estimate shown in the UI (USD per 1M tokens). 0 = free tier.
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

# Parallel evaluations in a batch. Keep 1–2 on free tiers.
BATCH_CONCURRENCY=1

# 1 = recording pauses in calls are not in the audio file, so seek positions skip them
AUDIO_SKIP_PAUSES=1

HOST=127.0.0.1
PORT=8000
